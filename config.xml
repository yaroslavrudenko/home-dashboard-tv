<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets"
        id="http://yaroslav.local/homedashboard" version="0.1.0" viewmodes="maximized">
    <tizen:application id="HomeDash01.Dashboard" package="HomeDash01" required_version="3.0"/>
    <name>Home Dashboard</name>
    <icon src="img/icon.png"/>
    <content src="index.html"/>
    <!-- Least privilege: the app's own files plus exactly the hosts it reads: weather (Open-Meteo), the news feeds of the
         three languages (NEWSru; Ynet, Globes; Ukrainska Pravda, Ekonomichna Pravda), the Israel alert feed and its recent
         alerts (both on www.oref.org.il since 2026-11-04), and Mapbox:
         the routes' live traffic (connect-src) and the live-traffic map image (img-src), and the markets: Yahoo's quotes and
         Coinbase's crypto stats (api.exchange) and currency rates (api), the air quality (Open-Meteo's air-quality API) and the Shabbat & holidays calendar (Hebcal)
         (connect-src). Widen it only when a new source
         ships. script-src file: covers $WEBAPIS/webapis/webapis.js, which the TV serves from its file system. -->
    <access origin="https://api.open-meteo.com" subdomains="false"/>
    <access origin="https://www.newsru.co.il" subdomains="false"/>
    <access origin="https://www.ynet.co.il" subdomains="false"/>
    <access origin="https://www.globes.co.il" subdomains="false"/>
    <access origin="https://www.pravda.com.ua" subdomains="false"/>
    <access origin="https://epravda.com.ua" subdomains="false"/>
    <access origin="https://www.oref.org.il" subdomains="false"/>
    <access origin="https://api.mapbox.com" subdomains="false"/>
    <access origin="https://query1.finance.yahoo.com" subdomains="false"/>
    <access origin="https://api.exchange.coinbase.com" subdomains="false"/>
    <access origin="https://api.coinbase.com" subdomains="false"/>
    <access origin="https://air-quality-api.open-meteo.com" subdomains="false"/>
    <access origin="https://www.hebcal.com" subdomains="false"/>
    <access origin="https://api.met.no" subdomains="false"/>
    <tizen:content-security-policy>default-src 'self'; script-src 'self' file:; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https://api.mapbox.com; connect-src https://api.open-meteo.com https://www.newsru.co.il https://www.ynet.co.il https://www.globes.co.il https://www.pravda.com.ua https://epravda.com.ua https://www.oref.org.il https://api.mapbox.com https://query1.finance.yahoo.com https://api.exchange.coinbase.com https://api.coinbase.com https://air-quality-api.open-meteo.com https://www.hebcal.com https://api.met.no</tizen:content-security-policy>
    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
    <tizen:profile name="tv-samsung"/>
    <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="disable"
                   encryption="disable" install-location="auto" hwkey-event="enable"/>
</widget>
