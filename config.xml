<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets"
        id="http://yaroslav.local/homedashboard" version="0.1.0" viewmodes="maximized">
    <tizen:application id="HomeDash01.Dashboard" package="HomeDash01" required_version="3.0"/>
    <name>Home Dashboard</name>
    <icon src="img/icon.png"/>
    <content src="index.html"/>
    <!-- Least privilege: the app's own files plus exactly the hosts it reads: weather (Open-Meteo), the two news
         feeds, the Israel alert feed and TomTom traffic (routing, map and traffic-flow tiles). Widen it only when a new source ships.
         script-src file: covers $WEBAPIS/webapis/webapis.js, which the TV serves from its file system. -->
    <access origin="https://api.open-meteo.com" subdomains="false"/>
    <access origin="https://www.ynet.co.il" subdomains="false"/>
    <access origin="https://www.globes.co.il" subdomains="false"/>
    <access origin="https://www.oref.org.il" subdomains="false"/>
    <access origin="https://api.tomtom.com" subdomains="false"/>
    <tizen:content-security-policy>default-src 'self'; script-src 'self' file:; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https://api.tomtom.com; connect-src https://api.open-meteo.com https://www.ynet.co.il https://www.globes.co.il https://www.oref.org.il https://api.tomtom.com</tizen:content-security-policy>
    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <tizen:profile name="tv-samsung"/>
    <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="disable"
                   encryption="disable" install-location="auto" hwkey-event="enable"/>
</widget>
