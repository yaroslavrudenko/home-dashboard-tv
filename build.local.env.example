# Copy to build.local.env (git-ignored) and fill in. See docs/DEPLOY.md for how to get the certificates.
# Tizen security profile holding your Samsung author + distributor certificates (tizen security-profiles list)
CERT_PROFILE=my-samsung-profile
# device-profile.xml that Samsung returned together with the distributor certificate
DEVICE_PROFILE=/Users/me/tizen-studio-data/keystore/my-tv/device-profile.xml
# The TV's last known sdb address; tools/find-tv.sh finds it again when the router moves it
TV=192.168.1.100:26101
# Optional: the TV's DUID (sdb shell 0 getduid). When set, the build installs only on the device that reports it.
TV_DUID=
